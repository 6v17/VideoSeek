{
  "kind": "understanding_component",
  "manifest_version": 1,
  "id": "audio/speech_to_text/faster-whisper-medium",
  "modality": "audio",
  "task": "speech_to_text",
  "model_id": "faster-whisper-medium",
  "display_name": "Faster-Whisper Medium (float16)",
  "package_version": "1.0.0",
  "description": "CTranslate2 Faster-Whisper medium for dialogue ASR. Prefer CUDA float16; CPU falls back to int8. Pack model files with this manifest, then Import Model.",
  "install_relpath": "components/audio/speech_to_text/faster-whisper-medium",
  "input_kind": "chunk_audio",
  "output_kind": "transcript",
  "engine": {
    "registry_key": "audio.speech_to_text.faster_whisper_medium"
  },
  "required_files": [
    "config.json",
    "model.bin",
    "tokenizer.json",
    "vocabulary.txt"
  ],
  "files": {
    "model": "model.bin"
  },
  "runtime": {
    "prefer_gpu": true,
    "device_hints": ["cuda", "cpu"],
    "compute_type_cuda": "float16",
    "compute_type_cpu": "int8"
  },
  "params": {
    "language": "auto",
    "vad_filter": true
  }
}
