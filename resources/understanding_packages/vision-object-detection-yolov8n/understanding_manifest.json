{
  "kind": "understanding_component",
  "manifest_version": 1,
  "id": "vision/object_detection/yolov8n",
  "modality": "vision",
  "task": "object_detection",
  "model_id": "yolov8n",
  "display_name": "YOLOv8n Object Detection (ONNX)",
  "package_version": "1.0.0",
  "description": "COCO-style object detection for chunk keyframes.",
  "install_relpath": "components/vision/object_detection/yolov8n",
  "input_kind": "chunk_keyframe",
  "output_kind": "objects",
  "engine": {
    "registry_key": "vision.object_detection.yolov8n"
  },
  "required_files": [
    "yolov8n.onnx"
  ],
  "files": {
    "model": "yolov8n.onnx"
  },
  "runtime": {
    "prefer_gpu": true,
    "provider_hints": [
      "DmlExecutionProvider",
      "CPUExecutionProvider"
    ]
  },
  "params": {
    "input_size": 640,
    "confidence_threshold": 0.25,
    "iou_threshold": 0.45,
    "class_names": "coco"
  }
}
